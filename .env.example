# ESPEJO FANTASMA — CONFIGURACIÓN

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/espejo_fantasma_dev
DATABASE_URL_PROD=postgresql://user:password@prod-db.render.com:5432/espejo_fantasma

# Stripe
STRIPE_API_KEY=sk_test_YOUR_TEST_KEY_HERE
STRIPE_API_KEY_PROD=sk_live_YOUR_LIVE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_WEBHOOK_SECRET

# API
API_HOST=localhost
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_BASE_URL_PROD=https://espejo-fantasma.render.com

# Frontend
FRONTEND_URL=http://localhost:8000/interface.html
FRONTEND_URL_PROD=https://espejo-fantasma.render.com/interface.html

# Encryption
SECRET_KEY=your-secret-key-min-32-chars-long-12345678
PBKDF2_ITERATIONS=480000

# GDPR
GDPR_RETENTION_DAYS=72
DATA_DELETION_ENABLED=true

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
